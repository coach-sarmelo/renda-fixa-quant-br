# ------------------------------------------------------------------
# Renda Fixa Quant BR — variáveis de ambiente
# Copie para .env e preencha o que for usar.
# ------------------------------------------------------------------

# --- Dados ---
# brapi (https://brapi.dev) — o endpoint de renda fixa exige plano pago:
# não utilizável hoje. Use --fonte=oficial (Tesouro Transparente, sem token).
BRAPI_TOKEN=
RFQ_CACHE_DIR=~/.rfquant/cache
RFQ_DB_PATH=~/.rfquant/db.sqlite

# --- Logging ---
RFQ_LOG_LEVEL=INFO
